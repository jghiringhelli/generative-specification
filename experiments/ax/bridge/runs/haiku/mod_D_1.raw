{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R5YcXZhnT1gNMFiRkUFoT3","type":"tool_result","content":"1\timport { getPrismaClient } from './infrastructure/database/PrismaClient';\n2\timport { PrismaUserRepository } from './infrastructure/repositories/PrismaUserRepository';\n3\timport { PrismaArticleRepository } from './infrastructure/repositories/PrismaArticleRepository';\n4\timport { PrismaCommentRepository } from './infrastructure/repositories/PrismaCommentRepository';\n5\timport { PrismaTagRepository } from './infrastructure/repositories/PrismaTagRepository';\n6\timport { BcryptPasswordHasher } from './infrastructure/security/PasswordHasher';\n7\timport { JwtTokenService } from './infrastructure/security/JwtTokenService';\n8\timport { UniqueSlugGenerator } from './infrastructure/utils/SlugGenerator';\n9\timport { UserService } from './application/services/UserService';\n10\timport { ProfileService } from './application/services/ProfileService';\n11\timport { ArticleService } from './application/services/ArticleService';\n12\timport { CommentService } from './application/services/CommentService';\n13\timport { TagService } from './application/services/TagService';\n14\timport { UserController } from './presentation/controllers/UserController';\n15\timport { ProfileController } from './presentation/controllers/ProfileController';\n16\timport { ArticleController } from './presentation/controllers/ArticleController';\n17\timport { CommentController } from './presentation/controllers/CommentController';\n18\timport { TagController } from './presentation/controllers/TagController';\n19\timport { AuthMiddleware } from './presentation/middleware/AuthMiddleware';\n20\t\n21\texport class DependencyContainer {\n22\t  private static instance: DependencyContainer;\n23\t\n24\t  public readonly userController: UserController;\n25\t  public readonly profileController: ProfileController;\n26\t  public readonly articleController: ArticleController;\n27\t  public readonly commentController: CommentController;\n28\t  public readonly tagController: TagController;\n29\t  public readonly authMiddleware: AuthMiddleware;\n30\t\n31\t  private constructor() {\n32\t    const prisma = getPrismaClient();\n33\t\n34\t    const userRepository = new PrismaUserRepository(prisma);\n35\t    const articleRepository = new PrismaArticleRepository(prisma);\n36\t    const commentRepository = new PrismaCommentRepository(prisma);\n37\t    const tagRepository = new PrismaTagRepository(prisma);\n38\t\n39\t    const passwordHasher = new BcryptPasswordHasher();\n40\t    const tokenService = new JwtTokenService();\n41\t    const slugGenerator = new UniqueSlugGenerator(articleRepository);\n42\t\n43\t    const userService = new UserService(userRepository, passwordHasher, tokenService);\n44\t    const profileService = new ProfileService(userRepository);\n45\t    const articleService = new ArticleService(articleRepository, userRepository, slugGenerator);\n46\t    const commentService = new CommentService(commentRepository, articleRepository, userRepository);\n47\t    const tagService = new TagService(tagRepository);\n48\t\n49\t    this.userController = new UserController(userService);\n50\t    this.profileController = new ProfileController(profileService);\n51\t    this.articleController = new ArticleController(articleService);\n52\t    this.commentController = new CommentController(commentService);\n53\t    this.tagController = new TagController(tagService);\n54\t    this.authMiddleware = new AuthMiddleware(tokenService);\n55\t  }\n56\t\n57\t  public static getInstance(): DependencyContainer {\n58\t    if (!DependencyContainer.instance) {\n59\t      DependencyContainer.instance = new DependencyContainer();\n60\t    }\n61\t    return DependencyContainer.instance;\n62\t  }\n63\t}\n64\t"}]},"parent_tool_use_id":null,"session_id":"aa9eb65b-69aa-4f71-8da5-a7308a9eac98","uuid":"332d9c70-f811-4146-af59-f7e0deb237a7","timestamp":"2026-09-07T15:06:25.500Z