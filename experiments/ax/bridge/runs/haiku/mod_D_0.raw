{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019UaDW6Py2JKTbnKDAmbFZJ","type":"tool_result","content":"1\timport { Response } from 'express';\n2\timport { ArticleService } from '../../application/services/ArticleService';\n3\t\n4\texport class ArticleController {\n5\t  constructor(private articleService: ArticleService) {}\n6\t\n7\t  listArticles = async (req: any, res: Response) => {\n8\t    try {\n9\t      const { tag, author, favorited, limit = '20', offset = '0' } = req.query;\n10\t\n11\t      const limitNum = parseInt(limit as string);\n12\t      const offsetNum = parseInt(offset as string);\n13\t\n14\t      const result = await this.articleService.listArticles(\n15\t        tag as string,\n16\t        author as string,\n17\t        favorited as string,\n18\t        limitNum,\n19\t        offsetNum,\n20\t        req.user?.id\n21\t      );\n22\t\n23\t      return res.status(200).json(result);\n24\t    } catch (error) {\n25\t      return res.status(500).json({\n26\t        errors: { body: ['Internal server error'] }\n27\t      });\n28\t    }\n29\t  };\n30\t\n31\t  getFeed = async (req: any, res: Response) => {\n32\t    try {\n33\t      const { limit = '20', offset = '0' } = req.query;\n34\t      const limitNum = parseInt(limit as string);\n35\t      const offsetNum = parseInt(offset as string);\n36\t\n37\t      const result = await this.articleService.getFeed(req.user!.id, limitNum, offsetNum);\n38\t\n39\t      return res.status(200).json(result);\n40\t    } catch (error) {\n41\t      return res.status(500).json({\n42\t        errors: { body: ['Internal server error'] }\n43\t      });\n44\t    }\n45\t  };\n46\t\n47\t  getArticle = async (req: any, res: Response) => {\n48\t    try {\n49\t      const { slug } = req.params;\n50\t\n51\t      const article = await this.articleService.getArticle(slug, req.user?.id);\n52\t\n53\t      if (!article) {\n54\t        return res.status(404).json({\n55\t          errors: { body: ['Article not found'] }\n56\t        });\n57\t      }\n58\t\n59\t      return res.status(200).json({ article });\n60\t    } catch (error) {\n61\t      return res.status(500).json({\n62\t        errors: { body: ['Internal server error'] }\n63\t      });\n64\t    }\n65\t  };\n66\t\n67\t  createArticle = async (req: any, res: Response) => {\n68\t    try {\n69\t      const { article } = req.body;\n70\t\n71\t      if (!article || !article.title || !article.description || !article.body) {\n72\t        return res.status(422).json({\n73\t          errors: { body: ['Title, description, and body are required'] }\n74\t        });\n75\t      }\n76\t\n77\t      const newArticle = await this.articleService.createArticle(\n78\t        article.title,\n79\t        article.description,\n80\t        article.body,\n81\t        article.tagList || [],\n82\t        req.user!.id\n83\t      );\n84\t\n85\t      return res.status(201).json({ article: newArticle });\n86\t    } catch (error) {\n87\t      return res.status(500).json({\n88\t        errors: { body: ['Internal server error'] }\n89\t      });\n90\t    }\n91\t  };\n92\t\n93\t  updateArticle = async (req: any, res: Response) => {\n94\t    try {\n95\t      const { slug } = req.params;\n96\t      const { article } = req.body;\n97\t\n98\t      const updatedArticle = await this.articleService.updateArticle(slug, article, req.user!.id);\n99\t\n100\t      if (!updatedArticle) {\n101\t        return res.status(404).json({\n102\t          errors: { body: ['Article not found'] }\n103\t        });\n104\t      }\n105\t\n106\t      return res.status(200).json({ article: updatedArticle });\n107\t    } catch (error: any) {\n108\t      if (error.message === 'Not authorized to update this article') {\n109\t        return res.status(403).json({\n110\t          errors: { body: ['Not authorized to update this article'] }\n111\t        });\n112\t      }\n113\t      return res.status(500).json({\n114\t        errors: { body: ['Internal server error'] }\n115\t      });\n116\t