{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016mTriGwsPARK6kTtuuiM1o","type":"tool_result","content":"1\timport { IArticleRepository } from '../../domain/repositories/IArticleRepository';\n2\timport { IUserRepository } from '../../domain/repositories/IUserRepository';\n3\timport { ISlugGenerator } from '../../infrastructure/utils/SlugGenerator';\n4\timport { ArticleWithMetadata } from '../../domain/entities/Article';\n5\t\n6\texport class ArticleService {\n7\t  constructor(\n8\t    private articleRepository: IArticleRepository,\n9\t    private userRepository: IUserRepository,\n10\t    private slugGenerator: ISlugGenerator\n11\t  ) {}\n12\t\n13\t  async listArticles(\n14\t    tag?: string,\n15\t    author?: string,\n16\t    favorited?: string,\n17\t    limit: number = 20,\n18\t    offset: number = 0,\n19\t    currentUserId?: number\n20\t  ): Promise<{ articles: Omit<ArticleWithMetadata, 'body'>[]; articlesCount: number }> {\n21\t    const filters: any = {};\n22\t\n23\t    if (tag) {\n24\t      filters.tag = tag;\n25\t    }\n26\t\n27\t    if (author) {\n28\t      const authorUser = await this.userRepository.findByUsername(author);\n29\t      if (authorUser) {\n30\t        filters.authorId = authorUser.id;\n31\t      } else {\n32\t        return { articles: [], articlesCount: 0 };\n33\t      }\n34\t    }\n35\t\n36\t    if (favorited) {\n37\t      const favoritedByUser = await this.userRepository.findByUsername(favorited);\n38\t      if (favoritedByUser) {\n39\t        filters.favoritedByUserId = favoritedByUser.id;\n40\t      } else {\n41\t        return { articles: [], articlesCount: 0 };\n42\t      }\n43\t    }\n44\t\n45\t    const [articles, articlesCount] = await Promise.all([\n46\t      this.articleRepository.findMany(filters, limit, offset),\n47\t      this.articleRepository.count(filters)\n48\t    ]);\n49\t\n50\t    const articlesWithMetadata = await Promise.all(\n51\t      articles.map(article => this.buildArticleListResponse(article.id, article, currentUserId))\n52\t    );\n53\t\n54\t    return { articles: articlesWithMetadata, articlesCount };\n55\t  }\n56\t\n57\t  async getFeed(\n58\t    currentUserId: number,\n59\t    limit: number = 20,\n60\t    offset: number = 0\n61\t  ): Promise<{ articles: Omit<ArticleWithMetadata, 'body'>[]; articlesCount: number }> {\n62\t    const followingIds = await this.getFollowingIds(currentUserId);\n63\t\n64\t    const [articles, articlesCount] = await Promise.all([\n65\t      this.articleRepository.findFeed(followingIds, limit, offset),\n66\t      this.articleRepository.countFeed(followingIds)\n67\t    ]);\n68\t\n69\t    const articlesWithMetadata = await Promise.all(\n70\t      articles.map(article => this.buildArticleListResponse(article.id, article, currentUserId))\n71\t    );\n72\t\n73\t    return { articles: articlesWithMetadata, articlesCount };\n74\t  }\n75\t\n76\t  async getArticle(slug: string, currentUserId?: number): Promise<ArticleWithMetadata | null> {\n77\t    const article = await this.articleRepository.findBySlug(slug);\n78\t\n79\t    if (!article) {\n80\t      return null;\n81\t    }\n82\t\n83\t    return await this.buildArticleResponse(article.id, article, currentUserId);\n84\t  }\n85\t\n86\t  async createArticle(\n87\t    title: string,\n88\t    description: string,\n89\t    body: string,\n90\t    tagList: string[],\n91\t    authorId: number\n92\t  ): Promise<ArticleWithMetadata> {\n93\t    const slug = await this.slugGenerator.generate(title);\n94\t\n95\t    const article = await this.articleRepository.create({\n96\t      slug,\n97\t      title,\n98\t      description,\n99\t      body,\n100\t      authorId\n101\t    });\n102\t\n103\t    if (tagList && Array.isArray(tagList)) {\n104\t      for (const tagName of tagList) {\n105\t        await this.articleRepository.addTag(article.id, tagName);\n106\t      }\n107\t    }\n108\t\n109\t    return await this.buildArticleResponse(article.id, article, authorId);\n110\t  }\n111\t\n112\t  async updateArticle(\n113\t    slug: string,\n114\t    updates: { title?: string; description?: string; body?: string },\n115\t    currentUserId: number\n116\t  ): Promise<ArticleWithMetadata | null> {\n117\t    const article = await this.articleRepository.findBySlug(slug);\n118\t\n119\t    if (!article) {\n120\t      return null;\n121\t    }\n122\t\n123\t    if (article.authorId !== currentUserId) {\n124\t      throw new Error('Not authorized to update this article');\n125\t    }\n126\t\n127\t    const updateData: any = {};\n128\t\n129\t    if (updates.title) {\n130\t      updateData.title = updates.title;\n131\t      updateData.slug = await this.slugGenerator.generate(updates.title);\n132\t    }\n133\t    if (updates.description) updateData.description = updates.description;\n134\t    if (updates.body) updateData.body = updates.body;\n135\t\n136\t    const updatedArticle = await this.articleRepository.update(slug, updateData);\n137\t\n138\t    return await this.buildArticleResponse(updatedArticle.id, updatedArticle, currentUserId);\n139\t  }\n140\t\n141\t  async deleteArticle(slug: string, currentUserId: number): Promise<boolean> {\n142\t    const article = await this.articleRepository.findBySlug(slug);\n143\t\n144\t    if (!article) {\n145\t      return false;\n146\t    }\n147\t\n148\t    if (article.authorId !== currentUserId) {\n149\t      throw new Error('Not authorized to delete this article');\n150\t    }\n151\t\n152\t    await this.articleRepository.delete(slug);\n153\t    return true;\n154\t  }\n155\t\n156\t  async favoriteArticle(slug: string, currentUserId: number): Promise<ArticleWithMetadata | null> {\n157\t    const article = await this.articleRepository.findBySlug(slug);\n158\t\n159\t    if (!article) {\n160\t      return null;\n161\t    }\n162\t\n163\t    await this.articleRepository.favorite(article.id, currentUserId);\n164\t\n165\t    return await this.buildArticleResponse(article.id, article, currentUserId);\n166\t  }\n167\t\n168\t  async unfavoriteArticle(slug: string, currentUserId: number): Promise<ArticleWithMetadata | null> {\n169\t    const article = await this.articleRepository.findBySlug(slug);\n170\t\n171\t    if (!article) {\n172\t      return null;\n173\t    }\n174\t\n175\t    await this.articleRepository.unfavorite(article.id, currentUserId);\n176\t\n177\t    return await this.buildArticleResponse(article.id, article, currentUserId);\n178\t  }\n179\t\n180\t  private async buildArticleResponse(\n181\t    articleId: number,\n182\t    article: any,\n183\t    currentUserId?: number\n184\t  ): Promise<ArticleWithMetadata> {\n185\t    const [tags, favoritesCount, favorited, author, following] = await Promise.all([\n186\t      this.articleRepository.getTags(articleId),\n187\t      this.articleRepository.getFavoritesCount(articleId),\n188\t      currentUserId ? this.articleRepository.isFavorited(articleId, currentUserId) : false,\n189\t      this.userRepository.findById(article.authorId),\n190\t      currentUserId && article.authorId\n191\t        ? this.userRepository.isFollowing(currentUserId, article.authorId)\n192\t        : false\n193\t    ]);\n194\t\n195\t    return {\n196\t      slug: article.slug,\n197\t      title: article.title,\n198\t      description: article.description,\n199\t      body: article.body,\n200\t      tagList: tags,\n201\t      createdAt: article.createdAt.toISOString(),\n202\t      updatedAt: article.updatedAt.toISOString(),\n203\t      favorited,\n204\t      favoritesCount,\n205\t      author: {\n206\t        username: author!.username,\n207\t        bio: author!.bio,\n208\t        image: author!.image,\n209\t        following\n210\t      }\n211\t    };\n212\t  }\n213\t\n214\t  private async buildArticleListResponse(\n215\t    articleId: number,\n216\t    article: any,\n217\t    currentUserId?: number\n218\t  ): Promise<Omit<ArticleWithMetadata, 'body'>> {\n219\t    const full = await this.buildArticleResponse(articleId, article, currentUserId);\n220\t    const { body, ...rest } = full;\n221\t    return rest;\n222\t  }\n223\t\n224\t  private async getFollowingIds(userId: number): Promise<number[]> {\n225\t    return await this.userRepository.getFollowingIds(userId);\n226\t  }\n227\t}\n228\t"}]},"parent_tool_use_id":null,"session_id":"2cde63d1-a22c-4c5e-9582-95cf3dcad2b5","uuid":"885a36b7-4eb9-47cc-b908-34bf5dca1536","timestamp":"2026-09-07T15:07:03.179Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\workspace\\PragmaWorks\\gs\\generative-specification\\experiments\\ax\\bridge\\D\\src\\application\\services\\ArticleService.ts","content":"import { IArticleRepository } from '../../domain/repositories/IArticleRepository';\nimport { IUserRepository } from '../../domain/repositories/IUserRepository';\nimport { ISlugGenerator } from '../../infrastructure/utils/SlugGenerator';\nimport { ArticleWithMetadata } from '../../domain/entities/Article';\n\nexport class ArticleService {\n  constructor(\n    private articleRepository: IArticleRepository,\n    private userRepository: IUserRepository,\n    private slugGenerator: ISlugGenerator\n  ) {}\n\n  async listArticles(\n    tag?: string,\n    author?: string,\n    favorited?: string,\n    limit: number = 20,\n    offset: number = 0,\n    currentUserId?: number\n  ): Promise<{ articles: Omit<ArticleWithMetadata, 'body'>[]; articlesCount: number }> {\n    const filters: any = {};\n\n    if (tag) {\n      filters.tag = tag;\n    }\n\n    if (author) {\n      const authorUser = await this.userRepository.findByUsername(author);\n      if (authorUser) {\n        filters.authorId = authorUser.id;\n      } else {\n        return { articles: [], articlesCount: 0 };\n      }\n    }\n\n    if (favorited) {\n      const favoritedByUser = await this.userRepository.findByUsername(favorited);\n      if (favoritedByUser) {\n        filters.favoritedByUserId = favoritedByUser.id;\n      } else {\n        return { articles: [], articlesCount: 0 };\n      }\n    }\n\n    const [articles, articlesCount] = await Promise.all([\n      this.articleRepository.findMany(filters, limit, offset),\n      this.articleRepository.count(filters)\n    ]);\n\n    const articlesWithMetadata = await Promise.all(\n      articles.map(article => this.buildArticleListResponse(article.id, article, currentUserId))\n    );\n\n    return { articles: articlesWithMetadata, articlesCount };\n  }\n\n  async getFeed(\n    currentUserId: number,\n    limit: number = 20,\n    offset: number = 0\n  ): Promise<{ articles: Omit<ArticleWithMetadata, 'body'>[]; articlesCount: number }> {\n    const followingIds = await this.getFollowingIds(currentUserId);\n\n    const [articles, articlesCount] = await Promise.all([\n      this.articleRepository.findFeed(followingIds, limit, offset),\n      this.articleRepository.countFeed(followingIds)\n    ]);\n\n    const articlesWithMetadata = await Promise.all(\n      articles.map(article => this.buildArticleListResponse(article.id, article, currentUserId))\n    );\n\n    return { articles: articlesWithMetadata, articlesCount };\n  }\n\n  async getArticle(slug: string, currentUserId?: number): Promise<ArticleWithMetadata | null> {\n    const article = await this.articleRepository.findBySlug(slug);\n\n    if (!article) {\n      return null;\n    }\n\n    return await this.buildArticleResponse(article.id, article, currentUserId);\n  }\n\n  async createArticle(\n    title: string,\n    description: string,\n    body: string,\n    tagList: string[],\n    authorId: number\n  ): Promise<ArticleWithMetadata> {\n    const slug = await this.slugGenerator.generate(title);\n\n    const article = await this.articleRepository.create({\n      slug,\n      title,\n      description,\n      body,\n      authorId\n    });\n\n    if (tagList && Array.isArray(tagList)) {\n      for (const tagName of tagList) {\n        await this.articleRepository.addTag(article.id, tagName);\n      }\n    }\n\n    return await this.buildArticleResponse(article.id, article, authorId);\n  }\n\n  async updateArticle(\n    slug: string,\n    updates: { title?: string; description?: string; body?: string },\n    currentUserId: number\n  ): Promise<ArticleWithMetadata | null> {\n    const article = await this.articleRepository.findBySlug(slug);\n\n    if (!article) {\n      return null;\n    }\n\n    if (article.authorId !== currentUserId) {\n      throw new Error('Not authorized to update this article');\n    }\n\n    const updateData: any = {};\n\n    if (updates.title) {\n      updateData.title = updates.title;\n      updateData.slug = await this.slugGenerator.generate(updates.title);\n    }\n    if (updates.description) updateData.description = updates.description;\n    if (updates.body) updateData.body = updates.body;\n\n    const updatedArticle = await this.articleRepository.update(slug, updateData);\n\n    return await this.buildArticleResponse(updatedArticle.id, updatedArticle, currentUserId);\n  }\n\n  async deleteArticle(slug: string, currentUserId: number): Promise<boolean> {\n    const article = await this.articleRepository.findBySlug(slug);\n\n    if (!article) {\n      return false;\n    }\n\n    if (article.authorId !== currentUserId) {\n      throw new Error('Not authorized to delete this article');\n    }\n\n    await this.articleRepository.delete(slug);\n    return true;\n  }\n\n  async favoriteArticle(slug: string, currentUserId: number): Promise<ArticleWithMetadata | null> {\n    const article = await this.articleRepository.findBySlug(slug);\n\n    if (!article) {\n      return null;\n    }\n\n    await this.articleRepository.favorite(article.id, currentUserId);\n\n    return await this.buildArticleResponse(article.id, article, currentUserId);\n  }\n\n  async unfavoriteArticle(slug: string, currentUserId: number): Promise<ArticleWithMetadata | null> {\n    const article = await this.articleRepository.findBySlug(slug);\n\n    if (!article) {\n      return null;\n    }\n\n    await this.articleRepository.unfavorite(article.id, currentUserId);\n\n    return await this.buildArticleResponse(article.id, article, currentUserId);\n  }\n\n  private async buildArticleResponse(\n    articleId: number,\n    article: any,\n    currentUserId?: number\n  ): Promise<ArticleWithMetadata> {\n    const [tags, favoritesCount, favorited, author, following] = await Promise.all([\n      this.articleRepository.getTags(articleId),\n      this.articleRepository.getFavoritesCount(articleId),\n      currentUserId ? this.articleRepository.isFavorited(articleId, currentUserId) : false,\n      this.userRepository.findById(article.authorId),\n      currentUserId && article.authorId\n        ? this.userRepository.isFollowing(currentUserId, article.authorId)\n        : false\n    ]);\n\n    return {\n      slug: article.slug,\n      title: article.title,\n      description: article.description,\n      body: article.body,\n      tagList: tags,\n      createdAt: article.createdAt.toISOString(),\n      updatedAt: article.updatedAt.toISOString(),\n      favorited,\n      favoritesCount,\n      author: {\n        username: author!.username,\n        bio: author!.bio,\n        image: author!.image,\n        following\n      }\n    };\n  }\n\n  private async buildArticleListResponse(\n    articleId: number,\n    article: any,\n    currentUserId?: number\n  ): Promise<Omit<ArticleWithMetadata, 'body'>> {\n    const full = await this.buildArticleResponse(articleId, article, currentUserId);\n    const { body, ...rest } = full;\n    return rest;\n  }\n\n  private async getFollowingIds(userId: number): Promise<number[]> {\n    return await this.userRepository.getFollowingIds(userId);\n  }\n}\n","numLines":228,"startLine":1,"totalLines":228}}}
