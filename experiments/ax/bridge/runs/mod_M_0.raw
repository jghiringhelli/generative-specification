{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0116ynZBqv5L5hywEZsZpTjP","type":"tool_result","content":"1\timport { Router } from 'express';\n2\timport { PrismaClient } from '@prisma/client';\n3\timport { authenticate, optionalAuthenticate } from '../middleware/auth';\n4\timport { AuthRequest } from '../types';\n5\timport { generateUniqueSlug } from '../utils/slug';\n6\t\n7\tconst router = Router();\n8\tconst prisma = new PrismaClient();\n9\t\n10\tinterface ArticleAuthor {\n11\t  username: string;\n12\t  bio: string | null;\n13\t  image: string | null;\n14\t  following: boolean;\n15\t}\n16\t\n17\tinterface ArticleResponse {\n18\t  slug: string;\n19\t  title: string;\n20\t  description: string;\n21\t  body: string;\n22\t  tagList: string[];\n23\t  createdAt: string;\n24\t  updatedAt: string;\n25\t  favorited: boolean;\n26\t  favoritesCount: number;\n27\t  author: ArticleAuthor;\n28\t}\n29\t\n30\tconst buildArticleResponse = async (\n31\t  article: any,\n32\t  currentUserId?: number\n33\t): Promise<ArticleResponse> => {\n34\t  const tags = await prisma.articleTag.findMany({\n35\t    where: { articleId: article.id },\n36\t    include: { tag: true }\n37\t  });\n38\t\n39\t  const favoritesCount = await prisma.favorite.count({\n40\t    where: { articleId: article.id }\n41\t  });\n42\t\n43\t  let favorited = false;\n44\t  if (currentUserId) {\n45\t    const favorite = await prisma.favorite.findUnique({\n46\t      where: {\n47\t        userId_articleId: {\n48\t          userId: currentUserId,\n49\t          articleId: article.id\n50\t        }\n51\t      }\n52\t    });\n53\t    favorited = !!favorite;\n54\t  }\n55\t\n56\t  const author = await prisma.user.findUnique({\n57\t    where: { id: article.authorId }\n58\t  });\n59\t\n60\t  let following = false;\n61\t  if (currentUserId && author) {\n62\t    const followRecord = await prisma.follow.findUnique({\n63\t      where: {\n64\t        followerId_followingId: {\n65\t          followerId: currentUserId,\n66\t          followingId: author.id\n67\t        }\n68\t      }\n69\t    });\n70\t    following = !!followRecord;\n71\t  }\n72\t\n73\t  return {\n74\t    slug: article.slug,\n75\t    title: article.title,\n76\t    description: article.description,\n77\t    body: article.body,\n78\t    tagList: tags.map((t) => t.tag.name),\n79\t    createdAt: article.createdAt.toISOString(),\n80\t    updatedAt: article.updatedAt.toISOString(),\n81\t    favorited,\n82\t    favoritesCount,\n83\t    author: {\n84\t      username: author!.username,\n85\t      bio: author!.bio,\n86\t      image: author!.image,\n87\t      following\n88\t    }\n89\t  };\n90\t};\n91\t\n92\tconst buildArticleListResponse = async (\n93\t  article: any,\n94\t  currentUserId?: number\n95\t): Promise<Omit<ArticleResponse, 'body'>> => {\n96\t  const full = await buildArticleResponse(article, currentUserId);\n97\t  const { body, ...rest } = full;\n98\t  return rest;\n99\t};\n100\t\n101\t// GET /api/articles - List articles\n102\trouter.get('/articles', optionalAuthenticate, async (req: AuthRequest, res) => {\n103\t  try {\n104\t    const { tag, author, favorited, limit = '20', offset = '0' } = req.query;\n105\t\n106\t    const limitNum = parseInt(limit as string);\n107\t    const offsetNum = parseInt(offset as string);\n108\t\n109\t    const where: any = {};\n110\t\n111\t    if (tag) {\n112\t      where.tags = {\n113\t        some: {\n114\t          tag: {\n115\t            name: tag as string\n116\t          }\n117\t        }\n118\t      };\n119\t    }\n120\t\n121\t    if (author) {\n122\t      const authorUser = await prisma.user.findUnique({\n123\t        where: { username: author as string }\n124\t      });\n125\t      if (authorUser) {\n126\t        where.authorId = authorUser.id;\n127\t      } else {\n128\t        return res.status(200).json({ articles: [], articlesCount: 0 });\n129\t      }\n130\t    }\n131\t\n132\t    if (favorited) {\n133\t      const favoritedByUser = await prisma.user.findUnique({\n134\t        where: { username: favorited as string }\n135\t      });\n136\t      if (favoritedByUser) {\n137\t        where.favorites = {\n138\t          some: {\n139\t            userId: favoritedByUser.id\n140\t          }\n141\t        };\n142\t      } else {\n143\t        return res.status(200).json({ articles: [], articlesCount: 0 });\n144\t      }\n145\t    }\n146\t\n147\t    const [articles, articlesCount] = await Promise.all([\n148\t      prisma.article.findMany({\n149\t        where,\n150\t        orderBy: { createdAt: 'desc' },\n151\t        take: limitNum,\n152\t        skip: offsetNum\n153\t      }),\n154\t      prisma.article.count({ where })\n155\t    ]);\n156\t\n157\t    const articlesResponse = await Promise.all(\n158\t      articles.map((article) =>\n159\t        buildArticleListResponse(article, req.user?.id)\n160\t      )\n161\t    );\n162\t\n163\t    return res.status(200).json({\n164\t      articles: articlesResponse,\n165\t      articlesCount\n166\t    });\n167\t  } catch (error) {\n168\t    return res.status(500).json({\n169\t      errors: { body: ['Internal server error'] }\n170\t    });\n171\t  }\n172\t});\n173\t\n174\t// GET /api/articles/feed - Get feed\n175\trouter.get(\n176\t  '/articles/feed',\n177\t  authenticate,\n178\t  async (req: AuthRequest, res) => {\n179\t    try {\n180\t      const { limit = '20', offset = '0' } = req.query;\n181\t      const limitNum = parseInt(limit as string);\n182\t      const offsetNum = parseInt(offset as string);\n183\t\n184\t      const following = await prisma.follow.findMany({\n185\t        where: { followerId: req.user!.id },\n186\t        select: { followingId: true }\n187\t      });\n188\t\n189\t      const followingIds = following.map((f) => f.followingId);\n190\t\n191\t      const [articles, articlesCount] = await Promise.all([\n192\t        prisma.article.findMany({\n193\t          where: {\n194\t            authorId: { in: followingIds }\n195\t          },\n196\t          orderBy: { createdAt: 'desc' },\n197\t          take: limitNum,\n198\t          skip: offsetNum\n199\t        }),\n200\t        prisma.article.count({\n201\t          where: {\n202\t            authorId: { in: followingIds }\n203\t          }\n204\t        })\n205\t      ]);\n206\t\n207\t      const articlesResponse = await Promise.all(\n208\t        articles.map((article) =>\n209\t          buildArticleListResponse(article, req.user!.id)\n210\t        )\n211\t      );\n212\t\n213\t      return res.status(200).json({\n214\t        articles: articlesResponse,\n215\t        articlesCount\n216\t      });\n217\t    } catch (error) {\n218\t      return res.status(500).json({\n219\t        errors: { body: ['Internal server error'] }\n220\t      });\n221\t    }\n222\t  }\n223\t);\n224\t\n225\t// GET /api/articles/:slug - Get article\n226\trouter.get(\n227\t  '/articles/:slug',\n228\t  optionalAuthenticate,\n229\t  async (req: AuthRequest, res) => {\n230\t    try {\n231\t      const { slug } = req.params;\n232\t\n233\t      const article = await prisma.article.findUnique({\n234\t        where: { slug }\n235\t      });\n236\t\n237\t      if (!article) {\n238\t        return res.status(404).json({\n239\t          errors: { body: ['Article not found'] }\n240\t        });\n241\t      }\n242\t\n243\t      const articleResponse = await buildArticleResponse(\n244\t        article,\n245\t        req.user?.id\n246\t      );\n247\t\n248\t      return res.status(200).json({ article: articleResponse });\n249\t    } catch (error) {\n250\t      return res.status(500).json({\n251\t        errors: { body: ['Internal server error'] }\n252\t      });\n253\t    }\n254\t  }\n255\t);\n256\t\n257\t// POST /api/articles - Create article\n258\trouter.post('/articles', authenticate, async (req: AuthRequest, res) => {\n259\t  try {\n260\t    const { article } = req.body;\n261\t\n262\t    if (!article || !article.title || !article.description || !article.body) {\n263\t      return res.status(422).json({\n264\t        errors: { body: ['Title, description, and body are required'] }\n265\t      });\n266\t    }\n267\t\n268\t    const slug = await generateUniqueSlug(article.title, prisma);\n269\t\n270\t    const newArticle = await prisma.article.create({\n271\t      data: {\n272\t        slug,\n273\t        title: article.title,\n274\t        description: article.description,\n275\t        body: article.body,\n276\t        authorId: req.user!.id\n277\t      }\n278\t    });\n279\t\n280\t    if (article.tagList && Array.isArray(article.tagList)) {\n281\t      for (const tagName of article.tagList) {\n282\t        let tag = await prisma.tag.findUnique({\n283\t          where: { name: tagName }\n284\t        });\n285\t\n286\t        if (!tag) {\n287\t          tag = await prisma.tag.create({\n288\t            data: { name: tagName }\n289\t          });\n290\t        }\n291\t\n292\t        await prisma.articleTag.create({\n293\t          data: {\n294\t            articleId: newArticle.id,\n295\t            tagId: tag.id\n296\t          }\n297\t        });\n298\t      }\n299\t    }\n300\t\n301\t    const articleResponse = await buildArticleResponse(\n302\t      newArticle,\n303\t      req.user!.id\n304\t    );\n305\t\n306\t    return res.status(201).json({ article: articleResponse });\n307\t  } catch (error) {\n308\t    return res.status(500).json({\n309\t      errors: { body: ['Internal server error'] }\n310\t    });\n311\t  }\n312\t});\n313\t\n314\t// PUT /api/articles/:slug - Update article\n315\trouter.put(\n316\t  '/articles/:slug',\n317\t  authenticate,\n318\t  async (req: AuthRequest, res) => {\n319\t    try {\n320\t      const { slug } = req.params;\n321\t      const { article } = req.body;\n322\t\n323\t      const existingArticle = await prisma.article.findUnique({\n324\t        where: { slug }\n325\t      });\n326\t\n327\t      if (!existingArticle) {\n328\t        return res.status(404).json({\n329\t          errors: { body: ['Article not found'] }\n330\t        });\n331\t      }\n332\t\n333\t      if (existingArticle.authorId !== req.user!.id) {\n334\t        return res.status(403).json({\n335\t          errors: { body: ['Not authorized to update this article'] }\n336\t        });\n337\t      }\n338\t\n339\t      const updateData: any = {};\n340\t\n341\t      if (article.title) {\n342\t        updateData.title = article.title;\n343\t        updateData.slug = await generateUniqueSlug(article.title, prisma);\n344\t      }\n345\t      if (article.description) updateData.description = article.description;\n346\t      if (article.body) updateData.body = article.body;\n347\t\n348\t      const updatedArticle = await prisma.article.update({\n349\t        where: { slug },\n350\t        data: updateData\n351\t      });\n352\t\n353\t      const articleResponse = await buildArticleResponse(\n354\t        updatedArticle,\n355\t        req.user!.id\n356\t      );\n357\t\n358\t      return res.status(200).json({ article: articleResponse });\n359\t    } catch (error) {\n360\t      return res.status(500).json({\n361\t        errors: { body: ['Internal server error'] }\n362\t      });\n363\t    }\n364\t  }\n365\t);\n366\t\n367\t// DELETE /api/articles/:slug - Delete article\n368\trouter.delete(\n369\t  '/articles/:slug',\n370\t  authenticate,\n371\t  async (req: AuthRequest, res) => {\n372\t    try {\n373\t      const { slug } = req.params;\n374\t\n375\t      const article = await prisma.article.findUnique({\n376\t        where: { slug }\n377\t      });\n378\t\n379\t      if (!article) {\n380\t        return res.status(404).json({\n381\t          errors: { body: ['Article not found'] }\n382\t        });\n383\t      }\n384\t\n385\t      if (article.authorId !== req.user!.id) {\n386\t        return res.status(403).json({\n387\t          errors: { body: ['Not authorized to delete this article'] }\n388\t        });\n389\t      }\n390\t\n391\t      await prisma.article.delete({\n392\t        where: { slug }\n393\t      });\n394\t\n395\t      return res.status(200).json({});\n396\t    } catch (error) {\n397\t      return res.status(500).json({\n398\t        errors: { body: ['Internal server error'] }\n399\t      });\n400\t    }\n401\t  }\n402\t);\n403\t\n404\t// POST /api/articles/:slug/favorite - Favorite article\n405\trouter.post(\n406\t  '/articles/:slug/favorite',\n407\t  authenticate,\n408\t  async (req: AuthRequest, res) => {\n409\t    try {\n410\t      const { slug } = req.params;\n411\t\n412\t      const article = await prisma.article.findUnique({\n413\t        where: { slug }\n414\t      });\n415\t\n416\t      if (!article) {\n417\t        return res.status(404).json({\n418\t          errors: { body: ['Article not found'] }\n419\t        });\n420\t      }\n421\t\n422\t      await prisma.favorite.upsert({\n423\t        where: {\n424\t          userId_articleId: {\n425\t            userId: req.user!.id,\n426\t            articleId: article.id\n427\t          }\n428\t        },\n429\t        update: {},\n430\t        create: {\n431\t          userId: req.user!.id,\n432\t          articleId: article.id\n433\t        }\n434\t      });\n435\t\n436\t      const articleResponse = await buildArticleResponse(\n437\t        article,\n438\t        req.user!.id\n439\t      );\n440\t\n441\t      return res.status(200).json({ article: articleResponse });\n442\t    } catch (error) {\n443\t      return res.status(500).json({\n444\t        errors: { body: ['Internal server error'] }\n445\t      });\n446\t    }\n447\t  }\n448\t);\n449\t\n450\t// DELETE /api/articles/:slug/favorite - Unfavorite article\n451\trouter.delete(\n452\t  '/articles/:slug/favorite',\n453\t  authenticate,\n454\t  async (req: AuthRequest, res) => {\n455\t    try {\n456\t      const { slug } = req.params;\n457\t\n458\t      const article = await prisma.article.findUnique({\n459\t        where: { slug }\n460\t      });\n461\t\n462\t      if (!article) {\n463\t        return res.status(404).json({\n464\t          errors: { body: ['Article not found'] }\n465\t        });\n466\t      }\n467\t\n468\t      await prisma.favorite.deleteMany({\n469\t        where: {\n470\t          userId: req.user!.id,\n471\t          articleId: article.id\n472\t        }\n473\t      });\n474\t\n475\t      const articleResponse = await buildArticleResponse(\n476\t        article,\n477\t        req.user!.id\n478\t      );\n479\t\n480\t      return res.status(200).json({ article: articleResponse });\n481\t    } catch (error) {\n482\t      return res.status(500).json({\n483\t        errors: { body: ['Internal server error'] }\n484\t      });\n485\t    }\n486\t  }\n487\t);\n488\t\n489\texport default router;\n490\t"}]},"parent_tool_use_id":null,"session_id":"19b350df-b844-46aa-9770-6982d054e15a","uuid":"044416c5-e483-4603-a5c4-073f7a09ec8c","timestamp":"2026-09-07T03:03:04.022Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\workspace\\PragmaWorks\\gs\\generative-specification\\experiments\\ax\\bridge\\M\\src\\routes\\articles.ts","content":"import { Router } from 'express';\nimport { PrismaClient } from '@prisma/client';\nimport { authenticate, optionalAuthenticate } from '../middleware/auth';\nimport { AuthRequest } from '../types';\nimport { generateUniqueSlug } from '../utils/slug';\n\nconst router = Router();\nconst prisma = new PrismaClient();\n\ninterface ArticleAuthor {\n  username: string;\n  bio: string | null;\n  image: string | null;\n  following: boolean;\n}\n\ninterface ArticleResponse {\n  slug: string;\n  title: string;\n  description: string;\n  body: string;\n  tagList: string[];\n  createdAt: string;\n  updatedAt: string;\n  favorited: boolean;\n  favoritesCount: number;\n  author: ArticleAuthor;\n}\n\nconst buildArticleResponse = async (\n  article: any,\n  currentUserId?: number\n): Promise<ArticleResponse> => {\n  const tags = await prisma.articleTag.findMany({\n    where: { articleId: article.id },\n    include: { tag: true }\n  });\n\n  const favoritesCount = await prisma.favorite.count({\n    where: { articleId: article.id }\n  });\n\n  let favorited = false;\n  if (currentUserId) {\n    const favorite = await prisma.favorite.findUnique({\n      where: {\n        userId_articleId: {\n          userId: currentUserId,\n          articleId: article.id\n        }\n      }\n    });\n    favorited = !!favorite;\n  }\n\n  const author = await prisma.user.findUnique({\n    where: { id: article.authorId }\n  });\n\n  let following = false;\n  if (currentUserId && author) {\n    const followRecord = await prisma.follow.findUnique({\n      where: {\n        followerId_followingId: {\n          followerId: currentUserId,\n          followingId: author.id\n        }\n      }\n    });\n    following = !!followRecord;\n  }\n\n  return {\n    slug: article.slug,\n    title: article.title,\n    description: article.description,\n    body: article.body,\n    tagList: tags.map((t) => t.tag.name),\n    createdAt: article.createdAt.toISOString(),\n    updatedAt: article.updatedAt.toISOString(),\n    favorited,\n    favoritesCount,\n    author: {\n      username: author!.username,\n      bio: author!.bio,\n      image: author!.image,\n      following\n    }\n  };\n};\n\nconst buildArticleListResponse = async (\n  article: any,\n  currentUserId?: number\n): Promise<Omit<ArticleResponse, 'body'>> => {\n  const full = await buildArticleResponse(article, currentUserId);\n  const { body, ...rest } = full;\n  return rest;\n};\n\n// GET /api/articles - List articles\nrouter.get('/articles', optionalAuthenticate, async (req: AuthRequest, res) => {\n  try {\n    const { tag, author, favorited, limit = '20', offset = '0' } = req.query;\n\n    const limitNum = parseInt(limit as string);\n    const offsetNum = parseInt(offset as string);\n\n    const where: any = {};\n\n    if (tag) {\n      where.tags = {\n        some: {\n          tag: {\n            name: tag as string\n          }\n        }\n      };\n    }\n\n    if (author) {\n      const authorUser = await prisma.user.findUnique({\n        where: { username: author as string }\n      });\n      if (authorUser) {\n        where.authorId = authorUser.id;\n      } else {\n        return res.status(200).json({ articles: [], articlesCount: 0 });\n      }\n    }\n\n    if (favorited) {\n      const favoritedByUser = await prisma.user.findUnique({\n        where: { username: favorited as string }\n      });\n      if (favoritedByUser) {\n        where.favorites = {\n          some: {\n            userId: favoritedByUser.id\n          }\n        };\n      } else {\n        return res.status(200).json({ articles: [], articlesCount: 0 });\n      }\n    }\n\n    const [articles, articlesCount] = await Promise.all([\n      prisma.article.findMany({\n        where,\n        orderBy: { createdAt: 'desc' },\n        take: limitNum,\n        skip: offsetNum\n      }),\n      prisma.article.count({ where })\n    ]);\n\n    const articlesResponse = await Promise.all(\n      articles.map((article) =>\n        buildArticleListResponse(article, req.user?.id)\n      )\n    );\n\n    return res.status(200).json({\n      articles: articlesResponse,\n      articlesCount\n    });\n  } catch (error) {\n    return res.status(500).json({\n      errors: { body: ['Internal server error'] }\n    });\n  }\n});\n\n// GET /api/articles/feed - Get feed\nrouter.get(\n  '/articles/feed',\n  authenticate,\n  async (req: AuthRequest, res) => {\n    try {\n      const { limit = '20', offset = '0' } = req.query;\n      const limitNum = parseInt(limit as string);\n      const offsetNum = parseInt(offset as string);\n\n      const following = await prisma.follow.findMany({\n        where: { followerId: req.user!.id },\n        select: { followingId: true }\n      });\n\n      const followingIds = following.map((f) => f.followingId);\n\n      const [articles, articlesCount] = await Promise.all([\n        prisma.article.findMany({\n          where: {\n            authorId: { in: followingIds }\n          },\n          orderBy: { createdAt: 'desc' },\n          take: limitNum,\n          skip: offsetNum\n        }),\n        prisma.article.count({\n          where: {\n            authorId: { in: followingIds }\n          }\n        })\n      ]);\n\n      const articlesResponse = await Promise.all(\n        articles.map((article) =>\n          buildArticleListResponse(article, req.user!.id)\n        )\n      );\n\n      return res.status(200).json({\n        articles: articlesResponse,\n        articlesCount\n      });\n    } catch (error) {\n      return res.status(500).json({\n        errors: { body: ['Internal server error'] }\n      });\n    }\n  }\n);\n\n// GET /api/articles/:slug - Get article\nrouter.get(\n  '/articles/:slug',\n  optionalAuthenticate,\n  async (req: AuthRequest, res) => {\n    try {\n      const { slug } = req.params;\n\n      const article = await prisma.article.findUnique({\n        where: { slug }\n      });\n\n      if (!article) {\n        return res.status(404).json({\n          errors: { body: ['Article not found'] }\n        });\n      }\n\n      const articleResponse = await buildArticleResponse(\n        article,\n        req.user?.id\n      );\n\n      return res.status(200).json({ article: articleResponse });\n    } catch (error) {\n      return res.status(500).json({\n        errors: { body: ['Internal server error'] }\n      });\n    }\n  }\n);\n\n// POST /api/articles - Create article\nrouter.post('/articles', authenticate, async (req: AuthRequest, res) => {\n  try {\n    const { article } = req.body;\n\n    if (!article || !article.title || !article.description || !article.body) {\n      return res.status(422).json({\n        errors: { body: ['Title, description, and body are required'] }\n      });\n    }\n\n    const slug = await generateUniqueSlug(article.title, prisma);\n\n    const newArticle = await prisma.article.create({\n      data: {\n        slug,\n        title: article.title,\n        description: article.description,\n        body: article.body,\n        authorId: req.user!.id\n      }\n    });\n\n    if (article.tagList && Array.isArray(article.tagList)) {\n      for (const tagName of article.tagList) {\n        let tag = await prisma.tag.findUnique({\n          where: { name: tagName }\n        });\n\n        if (!tag) {\n          tag = await prisma.tag.create({\n            data: { name: tagName }\n          });\n        }\n\n        await prisma.articleTag.create({\n          data: {\n            articleId: newArticle.id,\n            tagId: tag.id\n          }\n        });\n      }\n    }\n\n    const articleResponse = await buildArticleResponse(\n      newArticle,\n      req.user!.id\n    );\n\n    return res.status(201).json({ article: articleResponse });\n  } catch (error) {\n    return res.status(500).json({\n      errors: { body: ['Internal server error'] }\n    });\n  }\n});\n\n// PUT /api/articles/:slug - Update article\nrouter.put(\n  '/articles/:slug',\n  authenticate,\n  async (req: AuthRequest, res) => {\n    try {\n      const { slug } = req.params;\n      const { article } = req.body;\n\n      const existingArticle = await prisma.article.findUnique({\n        where: { slug }\n      });\n\n      if (!existingArticle) {\n        return res.status(404).json({\n          errors: { body: ['Article not found'] }\n        });\n      }\n\n      if (existingArticle.authorId !== req.user!.id) {\n        return res.status(403).json({\n          errors: { body: ['Not authorized to update this article'] }\n        });\n      }\n\n      const updateData: any = {};\n\n      if (article.title) {\n        updateData.title = article.title;\n        updateData.slug = await generateUniqueSlug(article.title, prisma);\n      }\n      if (article.description) updateData.description = article.description;\n      if (article.body) updateData.body = article.body;\n\n      const updatedArticle = await prisma.article.update({\n        where: { slug },\n        data: updateData\n      });\n\n      const articleResponse = await buildArticleResponse(\n        updatedArticle,\n        req.user!.id\n      );\n\n      return res.status(200).json({ article: articleResponse });\n    } catch (error) {\n      return res.status(500).json({\n        errors: { body: ['Internal server error'] }\n      });\n    }\n  }\n);\n\n// DELETE /api/articles/:slug - Delete article\nrouter.delete(\n  '/articles/:slug',\n  authenticate,\n  async (req: AuthRequest, res) => {\n    try {\n      const { slug } = req.params;\n\n      const article = await prisma.article.findUnique({\n        where: { slug }\n      });\n\n      if (!article) {\n        return res.status(404).json({\n          errors: { body: ['Article not found'] }\n        });\n      }\n\n      if (article.authorId !== req.user!.id) {\n        return res.status(403).json({\n          errors: { body: ['Not authorized to delete this article'] }\n        });\n      }\n\n      await prisma.article.delete({\n        where: { slug }\n      });\n\n      return res.status(200).json({});\n    } catch (error) {\n      return res.status(500).json({\n        errors: { body: ['Internal server error'] }\n      });\n    }\n  }\n);\n\n// POST /api/articles/:slug/favorite - Favorite article\nrouter.post(\n  '/articles/:slug/favorite',\n  authenticate,\n  async (req: AuthRequest, res) => {\n    try {\n      const { slug } = req.params;\n\n      const article = await prisma.article.findUnique({\n        where: { slug }\n      });\n\n      if (!article) {\n        return res.status(404).json({\n          errors: { body: ['Article not found'] }\n        });\n      }\n\n      await prisma.favorite.upsert({\n        where: {\n          userId_articleId: {\n            userId: req.user!.id,\n            articleId: article.id\n          }\n        },\n        update: {},\n        create: {\n          userId: req.user!.id,\n          articleId: article.id\n        }\n      });\n\n      const articleResponse = await buildArticleResponse(\n        article,\n        req.user!.id\n      );\n\n      return res.status(200).json({ article: articleResponse });\n    } catch (error) {\n      return res.status(500).json({\n        errors: { body: ['Internal server error'] }\n      });\n    }\n  }\n);\n\n// DELETE /api/articles/:slug/favorite - Unfavorite article\nrouter.delete(\n  '/articles/:slug/favorite',\n  authenticate,\n  async (req: AuthRequest, res) => {\n    try {\n      const { slug } = req.params;\n\n      const article = await prisma.article.findUnique({\n        where: { slug }\n      });\n\n      if (!article) {\n        return res.status(404).json({\n          errors: { body: ['Article not found'] }\n        });\n      }\n\n      await prisma.favorite.deleteMany({\n        where: {\n          userId: req.user!.id,\n          articleId: article.id\n        }\n      });\n\n      const articleResponse = await buildArticleResponse(\n        article,\n        req.user!.id\n      );\n\n      return res.status(200).json({ article: articleResponse });\n    } catch (error) {\n      return res.status(500).json({\n        errors: { body: ['Internal server error'] }\n      });\n    }\n  }\n);\n\nexport default router;\n","numLines":490,"startLine":1,"totalLines":490}}}
