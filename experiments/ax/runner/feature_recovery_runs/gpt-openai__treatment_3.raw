    orderBy: { _count: { tagName: 'desc' } },\n      take: limit,\n    });\n    return tags.map((tag) => ({\n      name: tag.tagName,\n      count: tag._count.tagName,\n    }));\n  }","originalFile":"import { PrismaClient } from '@prisma/client';\nimport { ITagRepository } from './ITagRepository';\n\nexport class PrismaTagRepository implements ITagRepository {\n  public constructor(private readonly client: PrismaClient) {}\n\n  public async list(): Promise<ReadonlyArray<string>> {\n    const tags = await this.client.tag.findMany({\n      where: { articles: { some: {} } },\n      select: { name: true },\n      orderBy: { name: 'asc' },\n    });\n    return tags.map((tag) => tag.name);\n  }\n\n  public async replaceArticleTags(\n    articleId: string,\n    tags: ReadonlyArray<string>,\n  ): Promise<void> {\n    await this.client.$transaction(async (transaction) => {\n      await transaction.articleTag.deleteMany({ where: { articleId } });\n      for (const name of new Set(tags)) {\n        await transaction.articleTag.create({\n          data: {\n            articleId,\n            tag: { connectOrCreate: { where: { name }, create: { name } } },\n          },\n        });\n      }\n    });\n  }\n\n  public async listByArticle(\n    articleId: string,\n  ): Promise<ReadonlyArray<string>> {\n    const tags = await this.client.articleTag.findMany({\n      where: { articleId },\n      select: { tagName: true },\n      orderBy: { tagName: 'asc' },\n    });\n    return tags.map((tag) => tag.tagName);\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":5,"lines":[" import { PrismaClient } from '@prisma/client';","-import { ITagRepository } from './ITagRepository';","+import { ITagRepository, TagCount } from './ITagRepository';"," "," export class PrismaTagRepository implements ITagRepository {","   public constructor(private readonly client: PrismaClient) {}"]},{"oldStart":13,"oldLines":6,"newStart":13,"newLines":19,"lines":["     return tags.map((tag) => tag.name);","   }"," ","+  public async listPopular(limit: number): Promise<ReadonlyArray<TagCount>> {","+    const tags = await this.client.articleTag.groupBy({","+      by: ['tagName'],","+      _count: { tagName: true },","+      orderBy: { _count: { tagName: 'desc' } },","+      take: limit,","+    });","+    return tags.map((tag) => ({","+      name: tag.tagName,","+      count: tag._count.tagName,","+    }));","+  }","+","   public async replaceArticleTags(","     articleId: string,","     tags: ReadonlyArray<string>,"]}],"userModified":false,"replaceAll":false}}
