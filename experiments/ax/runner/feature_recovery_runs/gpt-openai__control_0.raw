response, next) => {\n    try {\n      const userId = (request as AuthenticatedRequest).userId;\n      const { body } = createCommentSchema.parse(request.body).comment;\n      response.status(201).json({ comment: await service.create(request.params.slug as string, body, userId) });\n    } catch (error) { next(error); }\n  });\n\n  router.delete(\"/articles/:slug/comments/:id\", authenticate, async (request, response, next) => {\n    try {\n      const userId = (request as AuthenticatedRequest).userId;\n      await service.delete(request.params.slug as string, commentIdSchema.parse(request.params.id), userId);\n      response.sendStatus(204);\n    } catch (error) { next(error); }\n  });","originalFile":"import { Router } from \"express\";\nimport {\n  AuthenticatedRequest,\n  createAuthMiddleware,\n  createOptionalAuthMiddleware\n} from \"../middleware/auth\";\nimport { CommentService } from \"./comment.service\";\nimport { commentIdSchema, createCommentSchema } from \"./comment.schemas\";\n\n/** Creates article comment routes. */\nexport function createCommentRouter(service: CommentService, jwtSecret: string): Router {\n  const router = Router();\n  const authenticate = createAuthMiddleware(jwtSecret);\n  const optionalAuthenticate = createOptionalAuthMiddleware(jwtSecret);\n\n  router.get(\"/articles/:slug/comments\", optionalAuthenticate, async (request, response, next) => {\n    try {\n      const userId = (request as Partial<AuthenticatedRequest>).userId;\n      response.json({ comments: await service.list(request.params.slug, userId) });\n    } catch (error) { next(error); }\n  });\n\n  router.post(\"/articles/:slug/comments\", authenticate, async (request, response, next) => {\n    try {\n      const userId = (request as AuthenticatedRequest).userId;\n      const { body } = createCommentSchema.parse(request.body).comment;\n      response.status(201).json({ comment: await service.create(request.params.slug, body, userId) });\n    } catch (error) { next(error); }\n  });\n\n  router.delete(\"/articles/:slug/comments/:id\", authenticate, async (request, response, next) => {\n    try {\n      const userId = (request as AuthenticatedRequest).userId;\n      await service.delete(request.params.slug, commentIdSchema.parse(request.params.id), userId);\n      response.sendStatus(204);\n    } catch (error) { next(error); }\n  });\n\n  return router;\n}\n","structuredPatch":[{"oldStart":16,"oldLines":7,"newStart":16,"newLines":7,"lines":["   router.get(\"/articles/:slug/comments\", optionalAuthenticate, async (request, response, next) => {","     try {","       const userId = (request as Partial<AuthenticatedRequest>).userId;","-      response.json({ comments: await service.list(request.params.slug, userId) });","+      response.json({ comments: await service.list(request.params.slug as string, userId) });","     } catch (error) { next(error); }","   });"," "]},{"oldStart":24,"oldLines":14,"newStart":24,"newLines":14,"lines":["     try {","       const userId = (request as AuthenticatedRequest).userId;","       const { body } = createCommentSchema.parse(request.body).comment;","-      response.status(201).json({ comment: await service.create(request.params.slug, body, userId) });","+      response.status(201).json({ comment: await service.create(request.params.slug as string, body, userId) });","     } catch (error) { next(error); }","   });"," ","   router.delete(\"/articles/:slug/comments/:id\", authenticate, async (request, response, next) => {","     try {","       const userId = (request as AuthenticatedRequest).userId;","-      await service.delete(request.params.slug, commentIdSchema.parse(request.params.id), userId);","+      await service.delete(request.params.slug as string, commentIdSchema.parse(request.params.id), userId);","       response.sendStatus(204);","     } catch (error) { next(error); }","   });"]}],"userModified":false,"replaceAll":false}}
