{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019SyVfDWH572KqnrmsLRBYj","type":"tool_result","content":"1\tdatasource db {\n2\t  provider = \"postgresql\"\n3\t  url      = env(\"DATABASE_URL\")\n4\t}\n5\t\n6\tgenerator client {\n7\t  provider = \"prisma-client-js\"\n8\t}\n9\t\n10\tmodel User {\n11\t  id        String   @id @default(uuid())\n12\t  email     String   @unique\n13\t  username  String   @unique\n14\t  password  String\n15\t  bio       String?\n16\t  image     String?\n17\t  createdAt DateTime @default(now())\n18\t  updatedAt DateTime @updatedAt\n19\t\n20\t  articles  Article[]\n21\t  comments  Comment[]\n22\t  favorites Favorite[]\n23\t\n24\t  followedBy Follow[] @relation(\"following\")\n25\t  following  Follow[] @relation(\"follower\")\n26\t}\n27\t\n28\tmodel Follow {\n29\t  followerId  String\n30\t  followingId String\n31\t  follower    User     @relation(\"follower\", fields: [followerId], references: [id], onDelete: Cascade)\n32\t  following   User     @relation(\"following\", fields: [followingId], references: [id], onDelete: Cascade)\n33\t  createdAt   DateTime @default(now())\n34\t\n35\t  @@id([followerId, followingId])\n36\t}\n37\t\n38\tmodel Article {\n39\t  id          String   @id @default(uuid())\n40\t  slug        String   @unique\n41\t  title       String\n42\t  description String\n43\t  body        String\n44\t  createdAt   DateTime @default(now())\n45\t  updatedAt   DateTime @updatedAt\n46\t\n47\t  authorId    String\n48\t  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)\n49\t\n50\t  comments    Comment[]\n51\t  favorites   Favorite[]\n52\t  tags        Tag[]    @relation(\"ArticleTags\")\n53\t}\n54\t\n55\tmodel Tag {\n56\t  id       String    @id @default(uuid())\n57\t  name     String    @unique\n58\t  articles Article[] @relation(\"ArticleTags\")\n59\t}\n60\t\n61\tmodel Favorite {\n62\t  userId    String\n63\t  articleId String\n64\t  user      User     @relation(field