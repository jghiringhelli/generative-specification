{
  "name": "conduit-realworld-api",
  "version": "0.1.0",
  "description": "Conduit RealWorld API — Express 4 + Prisma 5 + PostgreSQL 16",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
