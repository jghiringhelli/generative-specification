# =============================================================================
# Conduit RealWorld API — Required Environment Variables
# Copy this file to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://conduit:conduit@localhost:5432/conduit_dev"

# -----------------------------------------------------------------------------
# JWT Authentication
# JWT_SECRET: Random string, minimum 32 characters. Rotate on compromise.
# JWT_EXPIRY: Token lifetime. Accepts ms-format strings (7d, 24h, 3600) or seconds (integer).
# -----------------------------------------------------------------------------
JWT_SECRET="change-me-to-a-random-secret-minimum-32-characters-long"
JWT_EXPIRY="7d"

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
