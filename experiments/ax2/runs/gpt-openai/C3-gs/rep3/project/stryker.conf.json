{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/**/*.ts", "!src/server.ts", "!src/types/**/*.d.ts"],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 65
  },
  "reporters": ["clear-text", "progress"]
}
