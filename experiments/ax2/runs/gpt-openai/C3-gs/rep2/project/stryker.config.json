{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/**/*.ts",
    "!src/server.ts",
    "!src/compositionRoot.ts",
    "!src/infrastructure/**/*.ts",
    "!src/repositories/Prisma*.ts",
    "!src/types/**/*.ts"
  ],
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.config.js"
  },
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 65
  }
}
