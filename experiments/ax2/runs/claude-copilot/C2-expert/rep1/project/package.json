{
  "name": "conduit-backend",
  "version": "1.0.0",
  "description": "RealWorld Conduit backend in TypeScript + Express + Prisma",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
